// ==========================================
// MODULE 9: PRODUCTION EXECUTION SYSTEM (PES)
// ==========================================

model Storyboard {
  id            String   @id @default(uuid())
  production_id String
  name          String
  version       Int      @default(1)
  status        String   @default("DRAFT") // DRAFT, REVIEW, APPROVED
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  Production Production        @relation(fields: [production_id], references: [id], onDelete: Cascade)
  Frames     StoryboardFrame[]
}

model StoryboardFrame {
  id             String  @id @default(uuid())
  storyboard_id  String
  frame_number   Int
  image_url      String?
  camera_notes   String?
  lens           String?
  lighting       String?
  movement       String?
  transitions    String?
  scene_ref      String?

  Storyboard Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)
}

model ShotList {
  id            String   @id @default(uuid())
  production_id String
  name          String
  status        String   @default("DRAFT")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
}

model SceneVersion {
  id          String   @id @default(uuid())
  scene_id    String
  version     Int      @default(1)
  content     Json?
  created_at  DateTime @default(now())

  Scene Scene @relation(fields: [scene_id], references: [id], onDelete: Cascade)
}

model PromptLibrary {
  id          String   @id @default(uuid())
  company_id  String
  category    String
  name        String
  description String?
  created_at  DateTime @default(now())

  Templates PromptTemplate[]
}

model PromptTemplate {
  id                String   @id @default(uuid())
  prompt_library_id String
  name              String
  template_text     String
  variables         Json?
  negative_prompts  String?
  reference_images  String[]
  ai_provider       String?
  model             String?
  version           Int      @default(1)
  created_at        DateTime @default(now())

  PromptLibrary PromptLibrary @relation(fields: [prompt_library_id], references: [id], onDelete: Cascade)
  Executions    PromptExecution[]
}

model PromptExecution {
  id                 String   @id @default(uuid())
  prompt_template_id String
  executed_by_id     String
  result_asset_id    String?
  execution_time_ms  Int?
  status             String   @default("SUCCESS") // PENDING, SUCCESS, FAILED
  created_at         DateTime @default(now())

  PromptTemplate PromptTemplate @relation(fields: [prompt_template_id], references: [id], onDelete: Cascade)
  User           User           @relation(fields: [executed_by_id], references: [id])
}

model AIAsset {
  id            String   @id @default(uuid())
  production_id String
  name          String
  asset_type    String // IMAGE, VIDEO, AUDIO, 3D
  url           String
  metadata      Json?
  prompt_link   String?
  status        String   @default("GENERATED")
  created_at    DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
  Versions   AssetVersion[]
}

model AssetVersion {
  id          String   @id @default(uuid())
  ai_asset_id String
  version     Int      @default(1)
  url         String
  changes     String?
  created_at  DateTime @default(now())

  AIAsset AIAsset @relation(fields: [ai_asset_id], references: [id], onDelete: Cascade)
}

model DailyProductionLog {
  id               String   @id @default(uuid())
  production_id    String
  date             DateTime
  crew_attendance  Json?
  equipment_usage  Json?
  incidents        String?
  risks            String?
  budget_notes     String?
  completion_pct   Float    @default(0)
  created_at       DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
  DirectorNotes DirectorNote[]
}

model DirectorNote {
  id            String   @id @default(uuid())
  daily_log_id  String
  note          String
  created_at    DateTime @default(now())

  DailyProductionLog DailyProductionLog @relation(fields: [daily_log_id], references: [id], onDelete: Cascade)
}

model ReviewRound {
  id            String   @id @default(uuid())
  production_id String
  name          String
  status        String   @default("OPEN") // OPEN, APPROVED, REJECTED
  created_at    DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
  Feedback   ClientFeedback[]
  Revisions  Revision[]
}

model ClientFeedback {
  id              String   @id @default(uuid())
  review_round_id String
  client_id       String?
  comments        String
  frame_reference String?
  status          String   @default("PENDING")
  created_at      DateTime @default(now())

  ReviewRound ReviewRound @relation(fields: [review_round_id], references: [id], onDelete: Cascade)
}

model Revision {
  id              String   @id @default(uuid())
  review_round_id String
  description     String
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  created_at      DateTime @default(now())

  ReviewRound ReviewRound @relation(fields: [review_round_id], references: [id], onDelete: Cascade)
}

model ApprovalCheckpoint {
  id            String   @id @default(uuid())
  production_id String
  name          String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approved_by   String?
  created_at    DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
}

model ProductionVersion {
  id            String   @id @default(uuid())
  production_id String
  version       Int      @default(1)
  details       Json?
  status        String   @default("DRAFT")
  created_at    DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
}

model RenderJob {
  id            String   @id @default(uuid())
  production_id String
  status        String   @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  progress      Float    @default(0)
  output_url    String?
  created_at    DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
}

model ExportJob {
  id            String   @id @default(uuid())
  production_id String
  format        String
  status        String   @default("QUEUED")
  url           String?
  created_at    DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
}

model DeliveryPackage {
  id            String   @id @default(uuid())
  production_id String
  name          String
  status        String   @default("PREPARING") // PREPARING, SENT, ACCEPTED
  assets        Json?
  created_at    DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
}

model ProductionChecklist {
  id            String   @id @default(uuid())
  production_id String
  name          String
  tasks         Json?
  status        String   @default("PENDING")
  created_at    DateTime @default(now())

  Production Production @relation(fields: [production_id], references: [id], onDelete: Cascade)
}
