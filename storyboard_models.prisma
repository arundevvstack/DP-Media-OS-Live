// ==========================================
// MODULE 9A: STORYBOARD STUDIO
// ==========================================

model StoryboardSection {
  id             String   @id @default(uuid())
  storyboard_id  String
  name           String
  description    String?
  sequence_order Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  Storyboard Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)
  Frames     StoryboardFrame[]
}

model CameraSetup {
  id             String   @id @default(uuid())
  frame_id       String   @unique
  angle          String?
  height         String?
  movement       String?
  lens           String?
  focal_length   String?
  notes          String?

  Frame StoryboardFrame @relation(fields: [frame_id], references: [id], onDelete: Cascade)
}

model LightingSetup {
  id             String   @id @default(uuid())
  frame_id       String   @unique
  key_light      String?
  fill_light     String?
  back_light     String?
  color_temp     String?
  mood           String?
  notes          String?

  Frame StoryboardFrame @relation(fields: [frame_id], references: [id], onDelete: Cascade)
}

model ArtDirection {
  id             String   @id @default(uuid())
  frame_id       String   @unique
  color_palette  Json?
  wardrobe       String?
  props          String?
  set_design     String?
  notes          String?

  Frame StoryboardFrame @relation(fields: [frame_id], references: [id], onDelete: Cascade)
}

model StoryboardComment {
  id             String   @id @default(uuid())
  storyboard_id  String?
  frame_id       String?
  user_id        String
  content        String
  thread_id      String?
  created_at     DateTime @default(now())

  Storyboard Storyboard? @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)
  Frame      StoryboardFrame? @relation(fields: [frame_id], references: [id], onDelete: Cascade)
  User       User @relation(fields: [user_id], references: [id])
}

model StoryboardApproval {
  id             String   @id @default(uuid())
  storyboard_id  String
  version_id     String?
  approved_by_id String
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  comments       String?
  created_at     DateTime @default(now())

  Storyboard Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)
  Version    StoryboardVersion? @relation(fields: [version_id], references: [id], onDelete: Cascade)
  Approver   User @relation(fields: [approved_by_id], references: [id])
}

model StoryboardVersion {
  id             String   @id @default(uuid())
  storyboard_id  String
  version_number Int
  snapshot_data  Json
  created_by_id  String
  created_at     DateTime @default(now())
  is_locked      Boolean  @default(false)

  Storyboard Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)
  User       User @relation(fields: [created_by_id], references: [id])
  Approvals  StoryboardApproval[]
}

model StoryboardTemplate {
  id             String   @id @default(uuid())
  company_id     String
  name           String
  description    String?
  structure_data Json
  created_by_id  String
  created_at     DateTime @default(now())

  User User @relation(fields: [created_by_id], references: [id])
  Company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

model StoryboardMoodboard {
  id             String   @id @default(uuid())
  storyboard_id  String   @unique
  name           String
  description    String?
  created_at     DateTime @default(now())

  Storyboard Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)
  References VisualReference[]
}

model VisualReference {
  id             String   @id @default(uuid())
  moodboard_id   String
  type           String // IMAGE, COLOR, TYPOGRAPHY, VIDEO, BRAND, AI
  url            String
  notes          String?
  tags           String[]
  created_at     DateTime @default(now())

  Moodboard StoryboardMoodboard @relation(fields: [moodboard_id], references: [id], onDelete: Cascade)
}

model FrameAnnotation {
  id             String   @id @default(uuid())
  frame_id       String
  user_id        String
  annotation_data Json // Contains drawing paths, coordinates, etc.
  created_at     DateTime @default(now())

  Frame StoryboardFrame @relation(fields: [frame_id], references: [id], onDelete: Cascade)
  User  User @relation(fields: [user_id], references: [id])
}
